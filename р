<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>BALDI'S LYRICS — DEMO</title>
<style>
  * { box-sizing: border-box; }
  html, body { min-height: 100%; }

  body {
    margin: 0;
    padding: 80px 16px 60px;
    font-family: "Comic Sans MS", "Comic Sans", "Chalkboard SE", "Segoe UI", sans-serif;
    color: #1a1a1a;
    background-color: #f2d84b;
    background-image:
      linear-gradient(180deg, transparent 92%, #3b6eb5 92%, #3b6eb5 100%),
      repeating-linear-gradient(90deg, rgba(255,255,255,.18) 0 2px, transparent 2px 60px);
    background-attachment: fixed;
  }

  header { max-width: 900px; margin: 0 auto 24px; text-align: center; }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 7vw, 3.6rem);
    letter-spacing: 3px;
    color: #f2d84b;
    line-height: 1.1;
    transform: rotate(-2deg);
    text-shadow:
      -3px -3px 0 #d62828,  3px -3px 0 #d62828,
      -3px  3px 0 #d62828,  3px  3px 0 #d62828,
      -3px  0   0 #d62828,  3px  0   0 #d62828,
       0   -3px 0 #d62828,  0    3px 0 #d62828,
       0    6px 0 #a11f1f,
       0   10px 14px rgba(0,0,0,.35);
  }

  .subtitle {
    display: inline-block;
    margin: 16px 0 0;
    padding: 8px 18px;
    background: #fff;
    border: 4px solid #1a1a1a;
    border-radius: 6px;
    font-size: .95rem;
    box-shadow: 4px 4px 0 #1a1a1a;
    transform: rotate(1deg);
  }

  .demo-stamp {
    position: fixed;
    top: 16px;
    left: 50%;
    transform: translateX(-50%) rotate(-3deg);
    z-index: 1000;
    padding: 8px 28px;
    font-family: inherit;
    font-size: clamp(1.1rem, 3.5vw, 1.9rem);
    font-weight: bold;
    letter-spacing: 6px;
    color: #fff;
    background: #d62828;
    border: 5px solid #1a1a1a;
    border-radius: 8px;
    box-shadow: 6px 6px 0 #1a1a1a;
    animation: demoPulse 1.2s ease-in-out infinite;
    user-select: none;
    cursor: pointer;
    transition: background .15s;
    text-align: center;
  }
  .demo-stamp:hover { background: #b81f1f; }

  .demo-stamp .counter {
    display: block;
    font-size: .65rem;
    letter-spacing: 2px;
    font-weight: normal;
    margin-top: 2px;
    opacity: .85;
    min-height: 1em;
  }

  @keyframes demoPulse {
    0%, 100% { transform: translateX(-50%) rotate(-3deg) scale(1); }
    50%      { transform: translateX(-50%) rotate(-3deg) scale(1.06); }
  }

  .demo-stamp.shake { animation: demoShake .12s ease-in-out; }
  @keyframes demoShake {
    0%   { transform: translateX(-50%) rotate(-3deg) scale(1.0); }
    30%  { transform: translateX(-50%) rotate(-6deg) scale(1.12); }
    60%  { transform: translateX(-50%) rotate(0deg)  scale(1.06); }
    100% { transform: translateX(-50%) rotate(-3deg) scale(1.0); }
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
    background: #2e5e3e;
    border: 12px solid #8b5a2b;
    border-radius: 10px;
    padding: 26px 22px 30px;
    box-shadow:
      inset 0 0 60px rgba(0,0,0,.45),
      0 12px 0 #5c3a1a,
      0 18px 30px rgba(0,0,0,.4);
    position: relative;
  }

  .watermark {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(-20deg);
    font-size: clamp(3rem, 12vw, 7rem);
    font-weight: bold;
    letter-spacing: 10px;
    color: rgba(214, 40, 40, .22);
    text-shadow:
      -2px -2px 0 rgba(214, 40, 40, .35),
       2px -2px 0 rgba(214, 40, 40, .35),
      -2px  2px 0 rgba(214, 40, 40, .35),
       2px  2px 0 rgba(214, 40, 40, .35);
    pointer-events: none;
    user-select: none;
    white-space: nowrap;
    z-index: 0;
  }

  .chalk {
    position: absolute;
    top: 10px;
    right: 22px;
    color: rgba(255,255,255,.4);
    font-size: .9rem;
    transform: rotate(4deg);
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  .lyrics-table {
    position: relative;
    z-index: 1;
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    background-color: #fdfdf5;
    border: 3px solid #1a1a1a;
    background-image:
      linear-gradient(90deg, transparent 0 44px, #e05a5a 44px, #e05a5a 46px, transparent 46px),
      repeating-linear-gradient(180deg, transparent 0 27px, #9db8dd 27px, #9db8dd 28px);
    background-origin: content-box;
    box-shadow: 6px 6px 0 #1a1a1a;
  }

  .lyrics-table th {
    text-align: left;
    padding: 12px 16px 12px 56px;
    font-size: .8rem;
    letter-spacing: 2px;
    color: #fff;
    background: #3b6eb5;
    border-bottom: 3px solid #1a1a1a;
  }

  .lyrics-table td {
    padding: 12px 16px 12px 56px;
    vertical-align: top;
    line-height: 28px;
    word-wrap: break-word;
    border-bottom: 1px dashed #c9c9b0;
  }

  .lyrics-table tbody tr:nth-child(odd) { background: rgba(255,255,255,.5); }

  .orig  { color: #3b3b3b; font-style: italic; }
  .trans { color: #123a1f; font-weight: bold; }

  .bell {
    position: relative;
    z-index: 1;
    display: block;
    margin: 26px auto 0;
    padding: 12px 26px;
    font-family: inherit;
    font-size: 1.05rem;
    font-weight: bold;
    color: #fff;
    background: #d62828;
    border: 4px solid #1a1a1a;
    border-radius: 50px;
    box-shadow: 5px 5px 0 #1a1a1a;
    cursor: pointer;
    transition: transform .08s, box-shadow .08s;
  }
  .bell:hover { background: #b81f1f; }
  .bell:active {
    transform: translate(4px, 4px);
    box-shadow: 1px 1px 0 #1a1a1a;
  }

  /* ===== СКРИМЕР ===== */
  .jumpscare {
    position: fixed;
    inset: 0;
    z-index: 100000;
    background: #000;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity .05s linear;
    overflow: hidden;
  }
  .jumpscare.active { opacity: 1; pointer-events: auto; }

  .jumpscare svg {
    width: 90vmin;
    height: 90vmin;
    max-width: 100vw;
    max-height: 100vh;
    animation: baldishake .28s infinite;
    image-rendering: pixelated;
    filter: drop-shadow(0 0 40px #c22);
    z-index: 3;
  }

  .jumpscare::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center,
      rgba(214,40,40,.35) 0%,
      rgba(0,0,0,.85) 60%,
      #000 100%);
    pointer-events: none;
    z-index: 1;
  }

  @keyframes baldishake {
    0%   { transform: scale(1.05) translate(-8px, 5px)  rotate(-0.8deg); }
    25%  { transform: scale(1.12) translate(7px, -7px)  rotate(1deg); }
    50%  { transform: scale(1.05) translate(-10px, -5px) rotate(-1.3deg); }
    75%  { transform: scale(1.12) translate(9px, 8px)   rotate(1.2deg); }
    100% { transform: scale(1.05) translate(-8px, 5px)  rotate(-0.8deg); }
  }

  .scare-hint {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    color: #fff;
    font-family: inherit;
    font-size: .85rem;
    opacity: .55;
    letter-spacing: 2px;
    z-index: 4;
  }

  @media (max-width: 640px) {
    body { padding-top: 70px; }
    .demo-stamp { padding: 6px 16px; letter-spacing: 3px; box-shadow: 4px 4px 0 #1a1a1a; }
    .watermark { font-size: clamp(2.4rem, 15vw, 4rem); letter-spacing: 5px; }
    .jumpscare svg { width: 100vmin; height: 100vmin; }

    .lyrics-table thead { display: none; }
    .lyrics-table, .lyrics-table tbody, .lyrics-table tr, .lyrics-table td {
      display: block; width: 100%;
    }
    .lyrics-table {
      background-image:
        linear-gradient(90deg, transparent 0 28px, #e05a5a 28px, #e05a5a 30px, transparent 30px),
        repeating-linear-gradient(180deg, transparent 0 27px, #9db8dd 27px, #9db8dd 28px);
    }
    .lyrics-table tr {
      margin-bottom: 14px;
      border-bottom: 2px solid #1a1a1a;
      padding-bottom: 10px;
    }
    .lyrics-table td { border: none; padding: 4px 12px 4px 40px; }
    .orig::before  { content: "EN — "; color: #d62828; font-style: normal; }
    .trans::before { content: "RU — "; color: #3b6eb5; }
  }
</style>
</head>
<body>

<div class="demo-stamp" id="demoStamp">
  DEMO!!!
  <span class="counter" id="demoCounter"></span>
</div>

<header>
  <h1>BALDI'S LYRICS</h1>
  <p class="subtitle">Перевод трека "You're Mine" от DAGames</p>
</header>

<div class="container">
  <div class="watermark">DEMO!!!</div>
  <div class="chalk">1 + 1 = 2</div>

  <table class="lyrics-table">
    <thead>
      <tr><th>ENGLISH</th><th>РУССКИЙ</th></tr>
    </thead>
    <tbody>
      <tr>
        <td class="orig">Hi, I'm Baldi, nice to meet ya<br>Fuck me in the ass and call me Patricia</td>
        <td class="trans">Привет, я Балди, рад нашей встрече!<br>Трахни меня в зад и зови меня Патрисией!</td>
      </tr>
      <tr>
        <td class="orig">Book's your game? Just shout my name<br>When you let me use my whip</td>
        <td class="trans">Нужны тебе книжки? Меня позови!<br>Когда ты дашь мне использовать мой кнут.</td>
      </tr>
      <tr>
        <td class="orig">So that's one book right, but you're all wrong<br>You haven't even let me use my thong</td>
        <td class="trans">Что ж, одна книга верна, но остальные — нет.<br>Ты даже не дал мне поносить мои стринги,</td>
      </tr>
      <tr>
        <td class="orig">While I sing you this song, it goes, "Ding-dong"<br>Like the door I open on you</td>
        <td class="trans">пока я пою эту песню.<br>Она звенит «динь-дон», как дверь, которой я тебя приложу!</td>
      </tr>
      <tr>
        <td class="orig">Here's a tip, abandon ship<br>Or you're gonna see me campfire willy</td>
        <td class="trans">Вот подсказка: покинь корабль,<br>или ты увидишь моего горячего дружка!</td>
      </tr>
    </tbody>
  </table>

  <button class="bell" id="bellBtn">🔔 Позвонить в звонок</button>
</div>

<!-- ===== СКРИМЕР (SVG рисуется из JS) ===== -->
<div class="jumpscare" id="jumpscare">
  <svg id="baldiSvg" viewBox="0 0 480 600" preserveAspectRatio="xMidYMid meet"
       xmlns="http://www.w3.org/2000/svg" shape-rendering="crispEdges"></svg>
  <div class="scare-hint">нажми, чтобы закрыть</div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {

  // ============================================================
  // ПИКСЕЛЬ-АРТ БАЛДИ (генерируется из текстовой сетки)
  // ============================================================
  const PIXEL_COLORS = {
    'S': '#dbb87a',   // кожа базовая
    'D': '#9a7a45',   // кожа тень (нос)
    'K': '#0f0f0f',   // контур / зрачок
    'W': '#f0f0f0',   // белок глаза
    'G': '#3ec23e',   // зелёная рубашка
    'R': '#c62828'    // рот
  };

  const BALDI_GRID = [
    "........................",
    "........KKKKKKKK........",
    ".....KKSSSSSSSSSSKK.....",
    "...KKSSSSSSSSSSSSSSKK...",
    "..KSSSSSSSSSSSSSSSSSSK..",
    ".KSSSSSSSSSSSSSSSSSSSSK.",
    ".KSSSSSSSSSSSSSSSSSSSSK.",
    "KSSSSSWWWSSSSSWWWSSSSSK.",
    "KSSSSSWKWSSSSSWKWSSSSSK.",
    "KSSSSSWKWSSSSSWKWSSSSSK.",
    "KSSSSSWWWSSSSSWWWSSSSSK.",
    "KSSSSSSSSSSSSSSSSSSSSSK.",
    "KSSSSSSSSSSSSSSSSSSSSSK.",
    "KSSSSSSSSSSDDSSSSSSSSSK.",
    "KSSSSSSSSSRRRRRSSSSSSSK.",
    "KSSSSSSSSSSSSSSSSSSSSSK.",
    "KSSSSSSSSSSSSSSSSSSSSSK.",
    "KSSSSSSSSSSSSSSSSSSSSSK.",
    ".KSSSSSSSSSSSSSSSSSSSSK.",
    ".KSSSSSSSSSSSSSSSSSSSSK.",
    "..KSSSSSSSSSSSSSSSSSSK..",
    "...KKSSSSSSSSSSSSSSKK...",
    ".....KKSSSSSSSSSSKK.....",
    ".......KKKKSSKKKK.......",
    "..........KSSK..........",
    "..........KSSK..........",
    ".....GGGGGGGGGGGGGG.....",
    "....GGGGGGGGGGGGGGGG....",
    "..GGGGGGGGGGGGGGGGGGGG..",
    "..GGGGGGGGGGGGGGGGGGGG.."
  ];

  const CELL = 20; // размер пикселя
  const svgEl = document.getElementById('baldiSvg');

  if (svgEl) {
    const frag = document.createDocumentFragment();
    BALDI_GRID.forEach((row, y) => {
      [...row].forEach((ch, x) => {
        if (ch === '.') return;
        const color = PIXEL_COLORS[ch];
        if (!color) return;
        const rect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
        rect.setAttribute('x', x * CELL);
        rect.setAttribute('y', y * CELL);
        rect.setAttribute('width', CELL);
        rect.setAttribute('height', CELL);
        rect.setAttribute('fill', color);
        frag.appendChild(rect);
      });
    });
    svgEl.appendChild(frag);
  }

  // ============================================================
  // ЗВУК
  // ============================================================
  let audioCtx = null;

  async function ensureCtx() {
    const Ctx = window.AudioContext || window.webkitAudioContext;
    if (!Ctx) return null;
    if (!audioCtx) audioCtx = new Ctx();
    if (audioCtx.state === 'suspended') await audioCtx.resume();
    return audioCtx;
  }

  async function ring() {
    try {
      const ctx = await ensureCtx();
      if (!ctx) return;
      const t = ctx.currentTime + 0.03;
      function bell(freq, start, dur, vol) {
        const partials = [
          { m: 1.0, g: 1.0 }, { m: 2.0, g: 0.4 },
          { m: 2.8, g: 0.2 }, { m: 4.2, g: 0.1 }
        ];
        partials.forEach(p => {
          const osc = ctx.createOscillator();
          const gn  = ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(freq * p.m, start);
          const peak = vol * p.g;
          gn.gain.setValueAtTime(0.0001, start);
          gn.gain.linearRampToValueAtTime(peak, start + 0.01);
          gn.gain.exponentialRampToValueAtTime(0.0001, start + dur);
          osc.connect(gn); gn.connect(ctx.destination);
          osc.start(start); osc.stop(start + dur + 0.1);
        });
      }
      bell(659.25, t,        1.1, 0.22);
      bell(523.25, t + 0.45, 1.4, 0.20);
    } catch (e) { console.error(e); }
  }

  async function slap() {
    try {
      const ctx = await ensureCtx();
      if (!ctx) return;
      const t = ctx.currentTime;

      const len = Math.floor(ctx.sampleRate * 0.12);
      const buf = ctx.createBuffer(1, len, ctx.sampleRate);
      const d = buf.getChannelData(0);
      for (let i = 0; i < len; i++) {
        const decay = Math.pow(1 - i / len, 3);
        d[i] = (Math.random() * 2 - 1) * decay;
      }
      const noise = ctx.createBufferSource();
      noise.buffer = buf;
      const nf = ctx.createBiquadFilter();
      nf.type = 'bandpass'; nf.frequency.value = 2500; nf.Q.value = 0.9;
      const ng = ctx.createGain();
      ng.gain.setValueAtTime(0.7, t);
      ng.gain.exponentialRampToValueAtTime(0.001, t + 0.14);
      noise.connect(nf); nf.connect(ng); ng.connect(ctx.destination);
      noise.start(t); noise.stop(t + 0.15);

      const osc = ctx.createOscillator();
      const og  = ctx.createGain();
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(180, t);
      osc.frequency.exponentialRampToValueAtTime(60, t + 0.1);
      og.gain.setValueAtTime(0.55, t);
      og.gain.exponentialRampToValueAtTime(0.001, t + 0.12);
      osc.connect(og); og.connect(ctx.destination);
      osc.start(t); osc.stop(t + 0.14);
    } catch (e) { console.error(e); }
  }

  async function screech() {
    try {
      const ctx = await ensureCtx();
      if (!ctx) return;
      const t = ctx.currentTime;

      const master = ctx.createGain();
      master.gain.value = 1.4;
      master.connect(ctx.destination);

      const shaper = ctx.createWaveShaper();
      const n = 1024;
      const curve = new Float32Array(n);
      for (let i = 0; i < n; i++) {
        const x = (i / (n - 1)) * 2 - 1;
        curve[i] = Math.tanh(x * 3);
      }
      shaper.curve = curve;
      shaper.connect(master);

      const len = Math.floor(ctx.sampleRate * 1.8);
      const buf = ctx.createBuffer(1, len, ctx.sampleRate);
      const d = buf.getChannelData(0);
      for (let i = 0; i < len; i++) d[i] = Math.random() * 2 - 1;
      const noise = ctx.createBufferSource();
      noise.buffer = buf;
      const nf = ctx.createBiquadFilter();
      nf.type = 'bandpass'; nf.frequency.value = 1800; nf.Q.value = 0.5;
      const ng = ctx.createGain();
      ng.gain.setValueAtTime(0.9, t);
      ng.gain.exponentialRampToValueAtTime(0.001, t + 1.6);
      noise.connect(nf); nf.connect(ng); ng.connect(shaper);
      noise.start(t); noise.stop(t + 1.7);

      [180, 233, 290, 366].forEach((f, i) => {
        const osc = ctx.createOscillator();
        const gn  = ctx.createGain();
        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(f * 6, t);
        osc.frequency.exponentialRampToValueAtTime(f * 0.5, t + 1.5);
        gn.gain.setValueAtTime(0.28, t + i * 0.01);
        gn.gain.exponentialRampToValueAtTime(0.001, t + 1.55);
        osc.connect(gn); gn.connect(shaper);
        osc.start(t); osc.stop(t + 1.6);
      });

      const hi = ctx.createOscillator();
      const hg = ctx.createGain();
      hi.type = 'square';
      hi.frequency.setValueAtTime(3200, t);
      hi.frequency.exponentialRampToValueAtTime(900, t + 1.2);
      hg.gain.setValueAtTime(0.18, t);
      hg.gain.exponentialRampToValueAtTime(0.001, t + 1.3);
      hi.connect(hg); hg.connect(shaper);
      hi.start(t); hi.stop(t + 1.4);

      const sub = ctx.createOscillator();
      const sg  = ctx.createGain();
      sub.type = 'square';
      sub.frequency.setValueAtTime(70, t);
      sub.frequency.exponentialRampToValueAtTime(28, t + 1.3);
      sg.gain.setValueAtTime(0.55, t);
      sg.gain.exponentialRampToValueAtTime(0.001, t + 1.5);
      sub.connect(sg); sg.connect(master);
      sub.start(t); sub.stop(t + 1.6);
    } catch (e) { console.error(e); }
  }

  // ============================================================
  // ЛОГИКА
  // ============================================================
  const REQUIRED_CLICKS = 5;
  const CLICK_TIMEOUT   = 1200;

  const demoStamp   = document.getElementById('demoStamp');
  const demoCounter = document.getElementById('demoCounter');
  const jumpscare   = document.getElementById('jumpscare');
  const bellBtn     = document.getElementById('bellBtn');

  if (bellBtn) bellBtn.addEventListener('click', ring);

  if (!demoStamp || !jumpscare) return;

  let clickCount = 0;
  let lastClickTime = 0;
  let resetTimer = null;
  let hideTimer = null;

  function updateCounter() {
    if (!demoCounter) return;
    demoCounter.textContent = clickCount > 0 ? clickCount + " / " + REQUIRED_CLICKS : "";
  }

  function resetCounter() { clickCount = 0; updateCounter(); }

  function triggerJumpscare() {
    document.body.style.background = '#fff';
    jumpscare.classList.add('active');
    screech();

    let flickers = 0;
    const flickerInt = setInterval(() => {
      flickers++;
      document.body.style.background = (flickers % 2) ? '#000' : '#fff';
      if (flickers > 8) {
        clearInterval(flickerInt);
        document.body.style.background = '';
      }
    }, 60);

    clearTimeout(hideTimer);
    hideTimer = setTimeout(hideJumpscare, 1800);
  }

  function hideJumpscare() {
    jumpscare.classList.remove('active');
    document.body.style.background = '';
  }

  demoStamp.addEventListener('click', () => {
    const now = Date.now();
    if (now - lastClickTime > CLICK_TIMEOUT) clickCount = 0;
    lastClickTime = now;

    clickCount++;
    slap();

    demoStamp.classList.remove('shake');
    void demoStamp.offsetWidth;
    demoStamp.classList.add('shake');

    updateCounter();

    if (clickCount >= REQUIRED_CLICKS) {
      resetCounter();
      triggerJumpscare();
      return;
    }

    clearTimeout(resetTimer);
    resetTimer = setTimeout(resetCounter, CLICK_TIMEOUT);
  });

  jumpscare.addEventListener('click', hideJumpscare);

  document.addEventListener('keydown', (e) => {
    if ((e.key === 'Escape' || e.key === ' ') && jumpscare.classList.contains('active')) {
      e.preventDefault();
      hideJumpscare();
    }
  });

});
</script>

</body>
</html>